# Copie este arquivo para .env (o .env NAO vai para o Git)
DB_URL=jdbc:postgresql://localhost:5435/bicocerto
DB_USERNAME=bicocerto
DB_PASSWORD=troque-esta-senha

# Segredo do JWT: no minimo 32 caracteres
JWT_SECRET=troque-por-um-segredo-grande-e-aleatorio-com-32-caracteres-ou-mais
JWT_EXPIRATION_MS=3600000

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
# Na nuvem (CloudAMQP): RABBITMQ_VHOST=<usuario>, RABBITMQ_SSL=true e RABBITMQ_PORT=5671
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Senha dos usuarios de teste criados na primeira execucao
SEED_PASSWORD=senha123
