        {
          "name": "Login cliente (Maria)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@bicocerto.com.br\",\n  \"senha\": \"{{senhaTeste}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"tokenCliente\", r.accessToken);",
                  "pm.test(\"Devolve token Bearer\", () => pm.expect(r.tokenType).to.eql(\"Bearer\"));"
                ]
              }
            }
          ]
        },
